# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and must NOT be committed.

# PostgreSQL connection string. Leave unset to use the local default
# `postgresql+psycopg2://localhost:5432/cardwarskingdom`.
# `postgres://` (Heroku), `postgresql://`, `postgres+psycopg2://` and
# `postgresql+psycopg2://` are all accepted and normalised to psycopg2.
# Use `sqlite:///instance/cardwarskingdom.db` to opt back into the legacy
# single-file database.
DATABASE_URL=

# Telegram bot used to deliver automatic backups.
# 1. Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Chat ID that receives the backups (the admin's Telegram user id or a group id).
TELEGRAM_ADMIN_ID=

# Optional: override the automatic backup interval (hours). Can also be set
# from the admin panel (Server page). 0 disables automatic backups.
BACKUP_INTERVAL_HOURS=4

# Google Sign-In: comma-separated OAuth client IDs the game's ID tokens must be
# issued for (audience check). Leave empty to disable Google account linking.
CWK_GOOGLE_CLIENT_IDS=

# Google browser OAuth (sign-in / account linking through a browser, used by
# /account/google/begin). Create a "Web application" OAuth client in Google Cloud
# and paste its id + secret. Leave empty to disable the browser flow.
CWK_GOOGLE_WEB_CLIENT_ID=
CWK_GOOGLE_WEB_CLIENT_SECRET=
