# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and must NOT be committed.

# Telegram bot used to deliver automatic backups.
# 1. Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Chat ID that receives the backups (the admin's Telegram user id or a group id).
TELEGRAM_ADMIN_ID=

# Optional: override the automatic backup interval (hours). Can also be set
# from the admin panel (Server page). 0 disables automatic backups.
BACKUP_INTERVAL_HOURS=4
